+<div class="prop-wrap">
+  <label class="pick" onclick="event.stopPropagation()">
+    <input type="checkbox" name="ids" value="{{ p.id }}" form="bulkform"
+           onchange="bulkChanged()" aria-label="{{ t('Select') }} {{ p.title }}">
+  </label>
+<a class="prop-row" href="{{ url_for('properties.detail', pid=p.id) }}">
+  {% set stand_in = p.owner_photo or p.partner_photo %}
+  <div class="prop-row-thumb {{ 'is-standin' if not p.cover and stand_in }}"
+       {% if p.cover %}style="background-image:url('{{ url_for('main.uploaded_file', kind='images', filename=p.cover) }}')"
+       {% elif stand_in %}style="background-image:url('{{ url_for('main.uploaded_file', kind='contacts', filename=stand_in) }}')"{% endif %}>
+    {% if not p.cover and not stand_in %}<span class="ph">{{ p.prop_type[0] }}</span>{% endif %}
+    {% if not p.cover and stand_in %}
+      <span class="standin-note">{{ p.owner_name or p.partner_name }}</span>
+    {% endif %}
+  </div>
+  <div class="prop-row-body">
+    <div class="prop-row-top">
+      <div>
+        <div class="mono faint">{{ p.ref }}</div>
+        <h4>{{ p.title }}</h4>
+        <div class="small muted">
+          {%- if p.floor_no %}{{ t('Floor') }} {{ p.floor_no }} · {% endif -%}
+          {%- if p.unit_no %}{{ t('Flat') }} {{ p.unit_no }} · {% endif -%}
+          {{ p.area or p.address or '—' }}</div>
+      </div>
+      <div class="prop-price">{{ currency }} {{ p.price | money }}</div>
+    </div>
+    <div class="prop-row-bottom">
+      <div class="tags">
+        <span class="tag tag-{{ 'sale' if p.listing_type == 'Sale' else 'rent' }}">{{ t(p.listing_type) }}</span>
+        <span class="tag tag-{{ p.status|lower }}">{{ t(p.status) }}</span>
+        {% if p.is_own %}<span class="tag tag-sale">{{ t('Ours') }}</span>{% endif %}
+        {% if p.status in ('Available', 'Reserved') and (not p.last_verified or p.last_verified < stale_cutoff) %}
+          <span class="tag tag-reserved">{{ t('Stale') }}</span>
+        {% endif %}
+      </div>
+      <div class="prop-meta">
+        <span>{{ t(p.prop_type) }}</span>
+        {% if p.bedrooms %}<span>{{ p.bedrooms }} {{ t('Bedrooms') }}</span>{% endif %}
+        {% if p.bathrooms %}<span>{{ p.bathrooms }} {{ t('Bathrooms') }}</span>{% endif %}
+        {% if p.size_sqm %}<span>{{ p.size_sqm | money }} m²</span>{% endif %}
+        <span>{{ p.agent_name or t('Unassigned') }}</span>
+      </div>
+    </div>
+  </div>
+</a>
+</div>
