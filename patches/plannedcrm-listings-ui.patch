   color: rgba(126, 98, 32, .30);
 }
 
+/* ---- list view: horizontal rows instead of a card grid */
+.prop-list { display: flex; flex-direction: column; gap: 10px; }
+
+.prop-row {
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  overflow: hidden;
+  display: flex;
+  transition: border-color .15s, box-shadow .15s;
+}
+
+.prop-row:hover { border-color: var(--gold); box-shadow: var(--shadow); }
+
+.prop-row-thumb {
+  flex: 0 0 160px;
+  aspect-ratio: 4 / 3;
+  background: var(--gold-tint);
+  background-size: cover;
+  background-position: center;
+  display: grid;
+  place-items: center;
+  border-right: 1px solid var(--line-soft);
+}
+[dir="rtl"] .prop-row-thumb { border-right: none; border-left: 1px solid var(--line-soft); }
+
+.prop-row-body {
+  padding: 12px 14px;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  flex: 1;
+  min-width: 0;
+}
+
+.prop-row-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
+.prop-row-top h4 { font-size: 15.5px; font-weight: 700; line-height: 1.3; }
+
+.prop-row-bottom {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  flex-wrap: wrap;
+  margin-top: auto;
+  padding-top: 6px;
+  border-top: 1px solid var(--line-soft);
+}
+.prop-row-bottom .tags { display: flex; gap: 6px; }
+.prop-row-bottom .prop-meta { border-top: none; padding-top: 0; margin-top: 0; }
+
+@media (max-width: 640px) {
+  .prop-row { flex-direction: column; }
+  .prop-row-thumb { flex: none; width: 100%; border-right: none; border-bottom: 1px solid var(--line-soft); }
+  [dir="rtl"] .prop-row-thumb { border-left: none; }
+}
+
 .prop-thumb .tags {
   position: absolute;
   top: 10px; left: 10px;
@@ -940,6 +997,40 @@ input[type=file] { font-size: 13px; font-family: var(--mono); }
 
 .filters .field { margin: 0; }
 
+/* ---- secondary filters, tucked behind a toggle so the bar stays short */
+.more-filters { margin-top: 12px; }
+
+.more-filters > summary {
+  list-style: none;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  font-family: var(--ui);
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: .07em;
+  text-transform: uppercase;
+  color: var(--muted);
+  user-select: none;
+  transition: color .12s;
+}
+.more-filters > summary::-webkit-details-marker { display: none; }
+.more-filters > summary:hover { color: var(--gold-deep); }
+
+.more-filters > summary::after {
+  content: "";
+  width: 6px; height: 6px;
+  border-right: 1.5px solid currentColor;
+  border-bottom: 1.5px solid currentColor;
+  transform: rotate(45deg) translate(-1px, -1px);
+  opacity: .65;
+  transition: transform .18s ease;
+}
+.more-filters[open] > summary::after { transform: rotate(-135deg); }
+
+.more-filters .filters { margin-top: 14px; }
+
 /* -------------------------------------------------------------- flash */
 .flash-wrap { padding: 0 26px; margin-top: 14px; }
 
@@ -1537,6 +1628,9 @@ body[lang="ar"],
 
 .prop-wrap { position: relative; }
 
+/* Hidden until the card is hovered/focused (or already picked) — it's a
+   bulk-select affordance, not something that needs to sit on every card at
+   all times. */
 .prop-wrap .pick {
   position: absolute;
   top: 10px; right: 10px;
@@ -1547,6 +1641,19 @@ body[lang="ar"],
   border-radius: var(--radius);
   box-shadow: 0 1px 3px rgba(0,0,0,.25);
   cursor: pointer;
+  opacity: 0;
+  transition: opacity .12s;
+}
+
+.prop-wrap:hover .pick,
+.prop-wrap .pick:focus-within,
+.prop-wrap:has(input:checked) .pick {
+  opacity: 1;
+}
+
+@media (hover: none) {
+  /* touch devices have no hover — keep it reachable, just quieter */
+  .prop-wrap .pick { opacity: .85; }
 }
 
 [dir="rtl"] .prop-wrap .pick { right: auto; left: 10px; }
