+<!doctype html>
+<html lang="{{ lang }}" dir="{{ 'rtl' if rtl else 'ltr' }}">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{{ t('Forgot password') }} · {{ company }}</title>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;450;500;550;600;700&family=IBM+Plex+Sans+Arabic:wght@400;450;500;600;700&family=IBM+Plex+Mono:wght@400;450;500&display=swap" rel="stylesheet">
+<link rel="stylesheet" href="{{ url_for('static', filename='css/app.css') }}">
+</head>
+<body>
+<div class="login-wrap">
+
+  <section class="login-art">
+    <div class="inline">
+      {% if logo_exists %}
+        <img src="{{ logo_url }}" alt="" style="width:64px;height:64px;object-fit:contain">
+      {% else %}
+        <span class="rail-mark">P</span>
+      {% endif %}
+      <span class="eyebrow" style="color:var(--gold)">{{ company }}</span>
+    </div>
+
+    <h1>{{ t('Every listing, ') }}<em>{{ t('every lead') }}</em>{{ t(', in one place.') }}</h1>
+
+    <div class="mono" style="color:#8A8578;letter-spacing:.12em">
+      {{ t('INTERNAL SYSTEM · DOHA, QATAR') }}
+    </div>
+  </section>
+
+  <section class="login-form">
+    <div class="login-box">
+      <div class="eyebrow">{{ t('Team access') }}</div>
+      <h2 class="page-title" style="margin-top:6px">{{ t('Forgot password') }}</h2>
+      <div class="hairline"></div>
+
+      {% with msgs = get_flashed_messages(with_categories=true) %}
+        {% for cat, m in msgs %}<div class="flash {{ cat }}">{{ t(m) }}</div>{% endfor %}
+      {% endwith %}
+
+      {% if mail_ready %}
+      <p class="small muted" style="margin:0 0 14px">{{ t("Type the email you sign in with. We'll send you a link to choose a new password.") }}</p>
+      <form method="post">
+        <div class="field">
+          <label for="email">{{ t('Work email') }}</label>
+          <input id="email" type="email" name="email" required autofocus autocomplete="username">
+        </div>
+        <button class="btn btn-gold" style="width:100%;justify-content:center" type="submit">
+          {{ t('Send reset link') }}
+        </button>
+      </form>
+      {% else %}
+      <p class="small muted">{{ t("Email isn't set up in this CRM yet, so a reset link can't be sent. Ask an admin to reset your password.") }}</p>
+      {% endif %}
+
+      <p class="small" style="margin-top:18px">
+        <a href="{{ url_for('auth.login') }}" style="color:var(--gold)">{{ t('Back to sign in') }}</a>
+      </p>
+    </div>
+  </section>
+
+</div>
+</body>
+</html>
