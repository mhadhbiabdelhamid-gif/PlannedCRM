# Copy to .env and fill in before deploying. Never commit the real .env.
SECRET_KEY=generate-a-long-random-string
ADMIN_EMAIL=admin@plannedrealestate.qa
ADMIN_PASSWORD=change-this-on-first-run
HTTPS_ONLY=1
TZ_OFFSET_HOURS=3
DATABASE_PATH=/var/data/crm.sqlite3
UPLOAD_FOLDER=/var/data/uploads

# Backups. Point this at a OneDrive or Google Drive folder and every
# automatic backup is carried off the machine for you.
# BACKUP_FOLDER=C:\Users\YourName\OneDrive\CRM-Backups
# BACKUP_KEEP=14
# BACKUP_INTERVAL_HOURS=24
